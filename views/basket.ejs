
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Корзина</title>
    <link rel="stylesheet" href="/styles/index.css">
</head>
<body>

<% if(id != 0){ %>
    <%- include('blocks/header') -%>

    <section class="section">
        <h2 class="section-title">Корзина пользователя <%= user.User_name %></h2>

        <% if(len == 0){ %> 
            <p>Ваша корзина пуста </p>

        <% } else { %>   
        <div class="cart-items">
            <% for(let i = 0; i < len; i++){ %>
                <div class="cart-item">
                    <img src="<%= products[i].Img %>" alt="">
                    <div>
                        <h3><%= products[i].Name %></h3>
                        <p class="price"><%= products[i].Price %> ₽</p>
                        <p>Количество: <%= products[i].Quantity %> шт.</p>
                    </div>
                </div>
            <% } %>
        </div>
        <% } %>

    </section>
<% } else{ %>
<%- include('blocks/header', {active_user: 0}) -%>
    <h1>Корзина пуста, необходима авторизация</h1>
    <a href="/login"><button>Войти</button></a>

<% } %>
<%- include('blocks/footer') -%>

</body>
</html>
