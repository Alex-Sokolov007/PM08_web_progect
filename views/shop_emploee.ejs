<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles/shop_emploee.css">
</head>
<body>
<%- include('blocks/header', {active_user: 1, role: 2}) -%>

<h1>Товары</h1>
<table>
    <tr>
        <th>Id</th>
        <th>Название</th>
        <th>Цена</th>
        <th>Img</th>
    </tr>
    <% for(let i = 0; i<len_products; i++) {%>
        <form action="/Shop_imploee/<%= shop_emploeer.Id %>" method="post">
            <tr>
                <td><input type="number" name="Id" readonly value="<%= products[i].Id %>"></td>
                <td><input type="text" name="Name" value="<%= products[i].Name %>"></td>
                <td><input type="number" name="Price" value="<%= products[i].Price %>"></td>
                <td><input type="text" name="Img" value="<%= products[i].Img %>"></td>
                <td><button type="submit">Сохранить</button></td>
                <td><input type="text" name="type" value="products" hidden></td>

            </tr>
        </form>
    <% } %>
        <form action="/Shop_imploee/<%= shop_emploeer.Id %>" method="post">
    <tr>
        <td><input type="number" name="Id" required readonly value="<%= products[products.length-1].Id + 1 %>"></td>
        <td><input type="text" name="Name" required value=""></td>
        <td><input type="number" name="Price" required value=""></td>
        <td><input type="text" name="Img" value=""></td>
        <td><button type="submit">Добавить</button></td>
        <td><input type="text" name="type" value="new_products" hidden></td>
        <td><input type="text" name="Id_Shop" hidden value="<%= shop_emploeer.shop.Id %>"></td>

    </tr>
        </form>
</table>

<h1>Заказы</h1>
<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Курьер</th>
            <th>Заказчик</th>
            <th>Статус оплаты</th>
            <th>Статус заявки</th>

            <th>Адрес</th>
        </tr>
    </thead>
    <tbody>
        <% for (let i = 0; i < orders.length; i++) { %>
        <form action="/Shop_imploee/<%= shop_emploeer.Id %>" method="post">
            <tr>
                <td><input type="number" name="Id" readonly value="<%= orders[i].Id %>"></td>
                <!-- Предполагаем, что Id_user_employee — это курьер -->
                <td><input type="number" name="Id_user_employee" value="<%= orders[i].Id_user_employee %>"></td>
                <!-- Id_user — заказчик -->
                <td onmouseout="hide_info_zakazchik('<%= orders[i].Id_user %>')" onmouseover="look_info_zakazchik('<%= orders[i].Id_user %>')"><input name="Id_user" type="number" value="<%= orders[i].Id_user %>"></td>
                <td><input name="pay_status" type="number" value="<%= orders[i].pay_status %>"></td>
                
<td> <select name="Order_status" id="status_<%= orders[i].Id %>">
        <% for(let j = 0; j < order_statuses.length; j++){ %>
            <option 
                value="<%= order_statuses[j].Id %>"
                <% if (order_statuses[j].Status === orders[i].Order_status){ %>
                    selected
                <% } %>
            >
                <%= order_statuses[j].Status %>
            </option>
        <% } %>
    </select>
</td>

                <td><input name="Adress" type="text" value="<%= orders[i].Adress %>"></td>
                <td><input type="text" name="Id_Shop" hidden value="<%= orders[i].Id_Shop %>"></td>
                <td><input type="text" hidden name="type" value="order"></td>
                
                <td><button type="submit">Сохранить</button></td>
                <div class="user_info" id="user_<%= orders[i].Id_user %>">
                    <%= zakazchici[i].Id %>
                    <%= zakazchici[i].User_name %>
                    <%= zakazchici[i].User_surname %>
                    <%= zakazchici[i].Login %>
                    <%= zakazchici[i].Phone %>
                </div>

            </tr>
        </form>            
        <% } %>
    </tbody>
</table>



<script>
    function look_info_zakazchik(Id){
    const userInfo = document.getElementById(`user_${Id}`);
    
    userInfo.style.left = (event.clientX + window.scrollX) + 'px';
    userInfo.style.top = (event.clientY + window.scrollY) + 'px';
    
    userInfo.style.display = 'flex';
    }

    function hide_info_zakazchik(Id){
    document.getElementById(`user_${Id}`).style.display = "none";
}

</script>

</body>
</html>