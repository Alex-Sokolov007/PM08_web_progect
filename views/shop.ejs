
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles/index.css">
</head>
<body>

<%- include('blocks/header', {active_user:active_user, role: role}) -%>

<section class="hero">
    <img src="<%= img %>" alt="" class="hero-img">
    <div class="hero-text">
        <h2><%= title %></h2>
        <p><%= adres %></p>
        <p>Телефон: <%= Hot_phone %></p>
    </div>
</section>

<section class="section">
    <h2 class="section-title">Товары</h2>

    <div class="products-grid">
        <% for(let i = 0; i < products.length; i++){ %>
            <div class="product-card">
                <img src="<%= products[i].Img %>" alt="">
                <div class="product-info">
                    <h3><%= products[i].Name %></h3>
                    <p class="price"><%= products[i].Price %> ₽</p>
                    <br>
                    <a href="/item/<%= products[i].Id %>/?user=<%= active_user %>&role=<%= role %>">
                        <button class="btn-orange">Подробнее</button>
                    </a>
                </div>
            </div>
        <% } %>
    </div>
</section>

<%- include('blocks/footer') -%>

</body>
</html>
