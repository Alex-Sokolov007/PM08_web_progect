
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Товар</title>
  <link rel="stylesheet" href="/styles/index.css"/>
</head>
<body>

<%- include('blocks/header', {active_user: active_user, role: role}) -%>

<section class="product-detail">
    
    <%try{ if(Id != undefined && Id != 0){ %>
        <div class="product-big">
            <img src="<%= Img %>" alt="">
            <div class="product-info">
                <h2><%= Name %></h2>
                <br>
                <p class="price"><%= Price %> ₽</p>
                <br>
                <p>Цена за <%= Measurement %> <%= Type_of_measurement %></p>
            <form action="/item/<%= Id %>/?user=<%= active_user %>&role=<%= role %>" method="post">
                <%if(in_basket){ %>
                    <h2>Товар уже добавлен</h2>
                <%}else{%>   
                <button class="btn-orange">Добавить в корзину</button>
                <% } %>
            </form>
            </div>
        </div>
    <% } else { %>
        <h2>Товар не найден</h2>
    <% }}catch{ %>
        <h2>Товар не найден</h2>
   <% } %>
</section>

<%- include('blocks/footer') -%>

</body>
</html>
