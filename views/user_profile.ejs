<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/index.css"/>

    <title>Document</title>
</head>
<body>

<%- include('blocks/header', {active_user: Id, role: role}) -%>

<% if(Id != 0) {%>
<section class="section">
    <form action="/user_profile/<%= Id %>" method="post">
        <p>Фамилия</p><input type="text" name="User_surname" id="" value="<%= User_surname %>"><br>
        <p>Имя</p><input type="text" name="User_name" id="" value="<%= User_name %>"><br>
        <p>Телефон</p><input type="text" name="Phone" id="" value="<%= Phone %>"><br>
        <p>Логин</p><input type="text" name="Login" id="" value="<%= Login %>"><br>
        <p>Введите старый пароль<input type="password" name="old_password"></p>
        <p>Введите новый пароль (если смена пароля не нужна, оставьте поле пустым)<input type="password" name="new_password"></p>
    <button type="submit" class="btn-orange btn">Обновить данные</button>
    </form>
</section>

<% }else{ %>
    <H1>Пользователь не найден</H1>
    <a href="/"><button>На главную</button></a>
<% } %>

<%- include('blocks/footer') -%>

</body>
</html>


